__pycache__/
**/__pycache__/
*.pyc

# Experiment outputs: each machine produces its own. No trailing slash, so a
# symlinked results/ is ignored too.
results

# In-place edit backups; git is the backup now.
*.bak-*

# Slurm job logs: per-cluster, never committed.
slurm-*.out

# near-initialisation checkpoints written by cc_reference_init_login.sh (binaries, ~25 MB)
init_checkpoints/

# --- marl-baseline branch ---------------------------------------------------
# Launchers/job scripts for the method's own studies live on the `fir` branch and are
# deliberately NOT tracked here; they remain on disk so the Fir working copy still runs.
# Listed so `git add -A` cannot pull them back in.
cc_*
!cc_baselines_10v10_gpu.sh
!cc_baselines_10v10_launch.sh
testrun*.sh
MANIFEST_*.txt
